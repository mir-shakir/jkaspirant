# Copy to .env.local and fill in. Never commit .env.local.

# Site
NEXT_PUBLIC_SITE_URL=https://jkaspirant.in

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by Server Actions, Route Handlers and scripts/ on the operator machine.
SUPABASE_SERVICE_ROLE_KEY=

# ISR revalidation (POST /api/revalidate with header x-revalidation-secret)
VERCEL_REVALIDATION_SECRET=

# Telegram channel posting (scripts/ only, never exposed to the client)
TELEGRAM_BOT_TOKEN=
# e.g. @jkaspirant or the numeric chat id (-100...)
TELEGRAM_CHANNEL_ID=
# Public join link shown on the site
NEXT_PUBLIC_TELEGRAM_URL=

# Paid bundles (paused for now)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
